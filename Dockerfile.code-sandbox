# 代码评测沙箱镜像
#
# 用途: HumanEval / MBPP / BigCodeBench / LiveCodeBench 执行模型生成代码的隔离环境。
# 平台用 `docker run --rm --network none --read-only ...` 跑一次性容器 (禁网/只读/资源上限),
# 因此代码所需依赖必须**预装**进镜像 (运行时无法 pip install)。
#
# 预装库覆盖各评测集需求:
#   - HumanEval / MBPP / LiveCodeBench: 仅标准库 (typing 等)
#   - BigCodeBench: pandas / numpy / matplotlib / scikit-learn / scipy / seaborn /
#     requests / faker / nltk / Pillow / beautifulsoup4 / python-docx / openpyxl /
#     opencv-python-headless / django / cryptography / python-dateutil / pytz
#
# 构建:  docker build -f Dockerfile.code-sandbox -t llm-eval-sandbox:latest .
# 使用:  在 config.yaml 设
#           server.code_exec.sandbox: "docker"
#           server.code_exec.image: "llm-eval-sandbox:latest"
#
# 镜像体积较大 (~1.5GB) 因含完整数据科学栈; 如只跑 HumanEval/MBPP/LiveCodeBench,
# 可改用官方 python:3.11-slim (仅标准库) 以节省体积。
#
# 国内网络: 已默认用清华 apt 源 + 阿里云 pip 源加速构建 (见下方 sed/pip -i)。
# 海外环境: 删除那两处镜像配置即可用官方源。

FROM python:3.11-slim

# 禁用字节码缓存 (-B) 减少只读文件系统写入; pip 不缓存减小镜像体积
ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 国内镜像源加速 (apt 用清华, pip 用阿里云); 海外环境可删除这3行用官方源
RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g; s|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null \
    || sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g; s|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list 2>/dev/null \
    || true

# 系统依赖: OpenCV (libGL 等) / 文档处理 / 编译所需
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# 数据科学 + 工具库 (BigCodeBench 全量覆盖) — 用阿里云 pip 镜像加速
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ \
        "pandas>=2.0" "numpy>=1.24" \
        "matplotlib>=3.7" "seaborn>=0.12" \
        "scikit-learn>=1.3" "scipy>=1.10" \
        "requests>=2.31" "beautifulsoup4>=4.12" "lxml>=4.9" \
        "Pillow>=10.0" "python-docx>=1.0" "openpyxl>=3.1" \
        "faker>=20.0" "nltk>=3.8" \
        "opencv-python-headless>=4.8" \
        "django>=4.2" "cryptography>=41.0" \
        "python-dateutil>=2.8" "pytz>=2023.3" \
        "sympy>=1.11"

# 容器以 stdin 接收代码 (平台用 `python -` 执行); 默认工作目录 /tmp (平台挂为 tmpfs 可写)
WORKDIR /tmp

# 无 CMD: 平台 docker run 时显式传 `python -`
